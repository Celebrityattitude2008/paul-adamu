rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI logged in to the "paul-adamu" project)
service cloud.firestore {
  match /databases/{database}/documents {

    // Public "Work" section data. Anyone can read; only the admin account
    // (checked via a custom claim set by Firebase Auth's built-in email match)
    // may write. Base64 image fields are capped implicitly by Firestore's
    // 1MB per-document limit — validated here at ~900KB to leave headroom
    // for the rest of the document.
    match /projects/{projectId} {
      allow read: if true;

      allow create, update: if isAdmin() && isValidProject();
      allow delete: if isAdmin();
    }

    // Public "Encrypted Channel" contact form. Anyone can create a message
    // (validated + size-capped below); only the admin account can read,
    // mark as read, or delete — messages are private correspondence, not
    // public content like projects.
    match /messages/{messageId} {
      allow create: if isValidMessage();
      allow read, update, delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isAdmin() {
    return request.auth != null &&
      request.auth.token.email == "pauladamu600@gmail.com" &&
      request.auth.token.email_verified == true;
  }

  function isValidMessage() {
    let data = request.resource.data;
    return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
      data.email is string && data.email.size() > 0 && data.email.size() < 200 &&
      data.message is string && data.message.size() > 0 && data.message.size() < 5000 &&
      data.read == false;
  }

  function isValidProject() {
    let data = request.resource.data;
    return data.title is string && data.title.size() > 0 &&
      data.slug is string && data.slug.size() > 0 &&
      data.category is string &&
      data.imageUrl is string &&
      // Rough guard against oversized base64 payloads (Firestore hard-caps documents at 1MB).
      data.imageUrl.size() < 950000 &&
      (!("screens" in data) || data.screens is list);
  }
}
