# Firebase Web SDK config (Firebase Console > Project settings > General > Your apps > Web app)
# These are safe to expose client-side — Firebase security is enforced via Firestore rules, not by hiding this config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Only this Google account can sign in to /admin
VITE_ADMIN_EMAIL=pauladamu600@gmail.com
